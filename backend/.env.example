# --- App ---
APP_ENV=development                # set to "production" when deployed (hides /docs, enforces JWT_SECRET)
FRONTEND_URL=http://localhost:5173 # exact origin(s) of your frontend, comma-separated, no trailing slash
# FRONTEND_URL_REGEX=https://your-project(-[a-z0-9-]+)?\.vercel\.app   # optional: allow Vercel preview URLs

# --- Database ---
# Local dev uses SQLite. In production use Postgres, e.g.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# --- Auth ---
JWT_SECRET=change-this-super-secret   # generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_HOURS=720

# --- AI (required for AI features) ---
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini    # syllabus/notes photos, photo doubts (gpt-4o for best handwriting OCR, ~6x cost)
OPENAI_PLANNER_MODEL=gpt-4.1-mini   # syllabus parsing, plan strategy, quizzes, flashcards
OPENAI_CHAT_MODEL=gpt-4.1-mini      # AI tutor chat

# --- Web research for plans (optional) ---
TAVILY_API_KEY=

# --- YouTube lecture suggestions (optional) ---
# Free key: Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key.
# Without it, students get a "Search on YouTube" link instead of ranked videos.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_SEARCH_LIMIT=90   # default quota = 10,000 units/day; each new search costs ~101

# --- Limits ---
MAX_UPLOAD_MB=15
AI_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Free AI allowance per user ---
# Daily allowance refreshes at midnight in BILLING_TIMEZONE; the monthly cap bounds worst-case cost.
# With gpt-4.1-mini, $0.25/day ≈ 80 tutor answers or ~40 quizzes a day.
DAILY_FREE_LIMIT_USD=0.25
MONTHLY_FREE_LIMIT_USD=6.0
BILLING_TIMEZONE=Asia/Kolkata
PAYMENTS_ENABLED=false
# Token costs are measured from real usage; these optional surcharges default to 0.
VISION_PARSE_ESTIMATE_USD=0
PDF_PARSE_ESTIMATE_USD=0
WEB_RESEARCH_ESTIMATE_USD=0.03   # Tavily searches when "research past papers" is on

# --- In-app help assistant (free for students, tightly limited) ---
OPENAI_HELP_MODEL=gpt-4.1-mini
HELP_RATE_LIMIT_PER_MINUTE=6
HELP_DAILY_LIMIT=60
